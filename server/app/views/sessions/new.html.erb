<h1>Sign in</h1>
<%= form_with url: session_path, method: :post do %>
  <div>
    <label>Email</label>
    <%= text_field_tag :email %>
  </div>
  <div>
    <label>Password</label>
    <%= password_field_tag :password %>
  </div>
  <div>
    <%= submit_tag "Sign in" %>
  </div>
<% end %>
<p><%= link_to "Create account", new_registration_path %> · <%= link_to "Forgot password?", new_password_path %></p>


